data-node
meili_data*
# librechat.yaml is deliberately NOT excluded: this deployment bakes its
# config into the image rather than mounting it at runtime. Anchored to root
# so this only matches librechat.example.yaml itself, not similarly-named
# paths elsewhere in the tree.
/librechat.example.yaml
Dockerfile*
docs

# Ignore all hidden files
.*

**/.circleci
**/.editorconfig
**/.dockerignore
**/.git
**/.DS_Store
**/.vscode
**/node_modules

# Specific patterns to ignore
data-node
meili_data*
librechat*
# vendor/ ships a vendored @librechat/agents tarball that Dockerfile.multi
# copies in before `npm ci`; librechat* above would otherwise exclude it.
!vendor/**
Dockerfile*
docs

# Ignore all hidden files
.*

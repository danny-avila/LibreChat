<%- include('../partials/head', { title: 'Пользователи — админ', user, nav: 'admin-users' }) %>
<h1>Пользователи и балансы</h1>
<% if (msg) { %><div class="notice"><%= msg %></div><% } %>
<section class="card">
  <div class="table-wrap"><table>
    <thead><tr><th>Email</th><th>Имя</th><th>Роль</th><th>Баланс</th><th>Корректировка</th></tr></thead>
    <tbody>
    <% users.forEach((u) => { %>
      <tr>
        <td><%= u.email %></td>
        <td><%= u.name || u.username || '—' %></td>
        <td><%= u.role %></td>
        <td><b><%= fmtCredits(u.credits) %></b></td>
        <td>
          <form method="post" action="<%= basePath %>/admin/users/<%= u._id %>/adjust" class="inline-form">
            <input name="delta" type="number" step="0.01" placeholder="± млн кредитов" required>
            <button class="btn small-btn" type="submit">Применить</button>
          </form>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table></div>
  <p class="muted small">Корректировка указывается в миллионах кредитов: «5» добавит 5 млн, «-2.5» спишет 2,5 млн. Каждая операция записывается в журнал транзакций LibreChat.</p>
</section>
<%- include('../partials/foot') %>

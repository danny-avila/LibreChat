<%- include('partials/head', { title: 'Тарифы и оплата', user, nav: 'billing' }) %>

<section class="balance-strip">
  <div>
    <div class="muted">Ваш тариф</div>
    <div class="balance-value">
      <% if (subscription && subscription.active) { %>
        <%= subscription.tariff?.title || '—' %> <span class="muted small">оплачен до <%= fmtDate(subscription.expiresAt) %></span>
      <% } else if (subscription) { %>
        <%= subscription.tariff?.title || '—' %> <span class="muted small danger">истёк <%= fmtDate(subscription.expiresAt) %></span>
      <% } else { %>
        <span class="muted">не подключён</span>
      <% } %>
    </div>
  </div>
  <% if (subscription && subscription.tariff) { %>
  <form method="post" action="<%= basePath %>/renew">
    <button class="btn primary" type="submit">Продлить</button>
  </form>
  <% } %>
</section>

<h1>Тарифы</h1>
<section class="tariffs">
  <% if (!tariffs.length) { %>
    <p class="muted">Тарифы пока не настроены. Загляните позже.</p>
  <% } %>
  <% tariffs.forEach((t) => { %>
    <div class="card tariff">
      <h2><%= t.title %></h2>
      <div class="tariff-price"><%= fmtRub(t.priceKopecks) %> <span class="muted small">/ <%= t.durationDays ?? 30 %> дн.</span></div>
      <% if (t.description) { %><p class="muted small"><%= t.description %></p><% } %>
      <% if (subscription && subscription.tariff && String(subscription.tariff.id) === String(t._id)) { %>
        <div class="muted small">Ваш текущий тариф</div>
        <form method="post" action="<%= basePath %>/renew">
          <button class="btn primary" type="submit">Продлить</button>
        </form>
      <% } else { %>
        <form method="post" action="<%= basePath %>/buy">
          <input type="hidden" name="tariffId" value="<%= t._id %>">
          <button class="btn primary" type="submit"><%= subscription && subscription.tariff ? 'Сменить' : 'Купить' %></button>
        </form>
      <% } %>
    </div>
  <% }) %>
</section>

<h1 id="history">История покупок и продлений</h1>
<section class="card">
  <% if (!orders.length) { %>
    <p class="muted">Покупок пока не было.</p>
  <% } else { %>
  <div class="table-wrap"><table>
    <thead><tr><th>Дата</th><th>Тариф</th><th>Сумма</th><th>Срок</th><th>Статус</th><th></th></tr></thead>
    <tbody>
      <% orders.forEach((o) => { %>
      <tr>
        <td><%= fmtDate(o.createdAt) %></td>
        <td><%= o.tariff.title %></td>
        <td><%= fmtRub(o.tariff.priceKopecks) %></td>
        <td><%= o.tariff.durationDays ? o.tariff.durationDays + ' дн.' : '—' %></td>
        <td><span class="status st-<%= o.status %>"><%= statusRu(o.status) %></span></td>
        <td>
          <% if (o.status === 'pending' && o.paymentUrl) { %>
            <a class="btn small-btn" href="<%= o.paymentUrl %>">Продолжить оплату</a>
          <% } %>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table></div>
  <% } %>
</section>

<%- include('partials/foot') %>

# Meo AI Web / LibreChat deployment fragment
# Copy the relevant values into the deployment .env. Do not commit real secrets.
APP_TITLE=Meo AI

# Meo Account is the only login authority for the Meo AI deployment.
ALLOW_EMAIL_LOGIN=false
ALLOW_REGISTRATION=false
ALLOW_SOCIAL_LOGIN=true
ALLOW_SOCIAL_REGISTRATION=true

# Supabase Auth OAuth 2.1 / OIDC issuer for the Meo Account project.
# Example: https://<project-ref>.supabase.co/auth/v1
OPENID_ISSUER=https://<project-ref>.supabase.co/auth/v1
OPENID_CLIENT_ID=<registered-meo-ai-web-client-id>
# Prefer a public OAuth client with PKCE. Leave OPENID_CLIENT_SECRET unset for that mode.
OPENID_CLIENT_SECRET=
OPENID_SCOPE="openid email profile"
OPENID_CALLBACK_URL=/oauth/openid/callback
OPENID_USE_PKCE=true
OPENID_BUTTON_LABEL=Continue with Meo
OPENID_AUTO_REDIRECT=true

# Keep the Meo Account access token only in the server-side OpenID session.
# The AI activity route uses this token to call Supabase under the user's own RLS identity;
# it is never copied to browser localStorage and no service-role key is required.
OPENID_REUSE_TOKENS=true
MEO_SUPABASE_URL=https://<project-ref>.supabase.co
MEO_SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# Deployment URLs.
DOMAIN_CLIENT=https://ai.example.invalid
DOMAIN_SERVER=https://ai.example.invalid

# Local development example:
# DOMAIN_CLIENT=http://localhost:3080
# DOMAIN_SERVER=http://localhost:3080

# Supabase project origin used by /api/meo to call the Account Edge Function.
# This is the project API origin, not the Flutter site at account.meoarch.org.
# The OAuth client ID must match OPENID_CLIENT_ID and be registered in Meo Account.
MEO_ACCOUNT_URL=https://<project-ref>.supabase.co
MEO_ACCOUNT_OAUTH_CLIENT_ID=<registered-meo-ai-web-client-id>
MEO_CLOUD_URL=https://ai.meoarch.org
